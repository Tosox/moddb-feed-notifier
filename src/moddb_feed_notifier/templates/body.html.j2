<div style="font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.5; color: #1a202c; max-width: 600px;">
  <h2 style="margin: 0 0 8px; font-size: 18px;">
    <a href="{{ item.url }}" style="color: #3182ce; text-decoration: none;">{{ item.title }}</a>
  </h2>
  <p style="margin: 0 0 12px; font-size: 13px; color: #4a5568;">
    Published {{ item.date.strftime("%Y-%m-%d %H:%M") }} UTC in
    <a href="{{ item.feed.url }}" style="color: #4a5568;">{{ item.feed.section }} · {{ item.feed.page }}</a>
  </p>
{% if item.image %}
  <a href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.title }}" style="display: block; max-width: 100%; border-radius: 4px; margin: 0 0 12px;"></a>
{% endif %}
  <p style="margin: 0 0 16px; padding: 12px 16px; border-left: 4px solid #8e0b0b; background: #f7fafc; white-space: pre-line;">{{ item.description }}</p>
  <a href="{{ item.url }}" style="display: inline-block; padding: 8px 16px; background: #8e0b0b; color: #ffffff; text-decoration: none; border-radius: 4px;">Open on ModDB</a>
  <p style="margin: 24px 0 0; font-size: 12px; color: #a0aec0;">Sent by ModDB Feed Notifier</p>
</div>
